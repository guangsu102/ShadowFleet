# ShadowFleet Docker 环境变量
# 只填必填项，其余配置已在 config.yaml 中完成

SHADOWFLEET_ENVIRONMENT=production
SHADOWFLEET_JWT_SECRET=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SHADOWFLEET_ASSET_CREDENTIAL_ENCRYPTION_KEY=
# Only used when the auth database does not contain any user.
SHADOWFLEET_BOOTSTRAP_ADMIN_PASSWORD=
# Comma-separated explicit origins. Leave empty when the UI is served same-origin.
SHADOWFLEET_CORS_ALLOWED_ORIGINS=
# Optional Xboard API integration. Keep its key out of config.yaml.
SHADOWFLEET_XBOARD_V2BX_API_HOST=
SHADOWFLEET_XBOARD_V2BX_API_KEY=
