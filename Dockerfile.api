# =============================================================================
# ShadowFleet API (FastAPI) Dockerfile
# =============================================================================
ARG PYTHON_VERSION=3.12-slim

FROM python:${PYTHON_VERSION} AS base

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

FROM base AS builder

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

FROM base

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

COPY --from=builder /opt/venv /opt/venv

COPY api ./api
COPY services ./services
COPY database ./database
COPY models ./models
COPY utils ./utils
COPY infrastructure ./infrastructure
COPY templates ./templates
COPY config.template.yaml ./config.yaml

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -sf http://localhost:8000/api/v1/health || exit 1

# Use gunicorn + uvicorn workers for stable multi-process production deployment
CMD ["gunicorn", "api.main:app", "--bind", "0.0.0.0:8000", "--workers", "4", "--worker-class", "uvicorn.workers.UvicornWorker", "--timeout", "120", "--keep-alive", "5"]
